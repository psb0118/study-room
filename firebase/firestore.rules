rules_version = '2';

// Firestore 보안 규칙
// - 학생은 자기 프로필과 플래너 데이터만 수정할 수 있다.
// - 부모는 6자리 가족 코드로 연결된 자녀의 프로필/계획을 읽고,
//   계획을 추가·삭제·완료 취소할 수 있다.
// - 관리자는 사용자 프로필의 이용 상태 필드만 변경할 수 있다.
// - 정지된 계정은 프로필을 읽을 수 있지만, 학습 데이터 접근과 수정은 차단된다.
// - 포인트 순위(leaderboard)는 로그인한 사용자에게 공개되는 요약 정보만 담는다.
// - 주간 리그(weeklyLeaderboards)는 주차별 하위 컬렉션으로 분리해 공개한다.
// - 그 외 경로는 모두 차단한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAccountActive() {
      return signedIn()
        && (
          !exists(
            /databases/$(database)/documents/studyUsers/$(request.auth.uid)
          )
          || get(
            /databases/$(database)/documents/studyUsers/$(request.auth.uid)
          ).data.accountStatus != 'suspended'
        );
    }

    function isParentOf(studentUid) {
      return signedIn()
        && isAccountActive()
        && exists(
          /databases/$(database)/documents/families/$(studentUid)/parents/$(request.auth.uid)
        );
    }

    // 앱 관리자 계정. 화면과 src/lib/admin.ts의 ADMIN_EMAIL을 함께 유지한다.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'soundpsb1@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function canReadStudentData(uid) {
      return isSelf(uid) || isParentOf(uid);
    }

    // 관리자는 다른 사용자의 상태 필드만 바꿀 수 있다.
    function isAdminStatusUpdate(targetUid) {
      return isAdmin()
        && request.auth.uid != targetUid
        && isAccountActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['accountStatus', 'statusReason', 'statusUpdatedAt', 'statusUpdatedBy']
        )
        && request.resource.data.statusReason is string
        && request.resource.data.statusReason.trim().size() <= 200
        && (
          (
            request.resource.data.accountStatus == 'active'
            && request.resource.data.statusReason.size() == 0
          )
          || (
            request.resource.data.accountStatus == 'suspended'
            && request.resource.data.statusReason.trim().size() > 0
          )
        );
    }

    match /studyUsers/{uid} {
      allow read: if canReadStudentData(uid) || isAdmin();
      allow create: if isSelf(uid);
      allow update: if (isSelf(uid) && isAccountActive())
        || isAdminStatusUpdate(uid);
      allow delete: if isSelf(uid) && isAccountActive();

      // planner: subjects / plans / records
      match /plans/{planId} {
        allow read, write: if canReadStudentData(uid) && isAccountActive();
      }

      match /subjects/{subjectId} {
        allow read: if canReadStudentData(uid) && isAccountActive();
        allow write: if isSelf(uid) && isAccountActive();
      }

      match /records/{recordId} {
        allow read: if canReadStudentData(uid) && isAccountActive();
        allow write: if isSelf(uid) && isAccountActive();
      }
    }

    // 학생이 만든 6자리 연결 코드. 로그인한 사용자만 코드로 학생을 찾을 수 있다.
    match /familyCodes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && isAccountActive()
        && request.resource.data.studentUid == request.auth.uid;
      allow delete: if signedIn()
        && isAccountActive()
        && resource.data.studentUid == request.auth.uid;
    }

    // 부모 연결 문서. 부모는 유효한 코드를 가진 경우에만 자기 연결을 만들 수 있다.
    match /families/{studentUid} {
      allow read: if canReadStudentData(studentUid);
      allow write: if false;

      match /parents/{parentUid} {
        allow read: if isSelf(studentUid) || isSelf(parentUid);
        allow create: if signedIn()
          && isAccountActive()
          && request.auth.uid == parentUid
          && request.resource.data.uid == parentUid
          && request.resource.data.code is string
          && exists(
            /databases/$(database)/documents/familyCodes/$(request.resource.data.code)
          )
          && get(
            /databases/$(database)/documents/familyCodes/$(request.resource.data.code)
          ).data.studentUid == studentUid;
        allow delete: if isAccountActive()
          && (isSelf(studentUid) || isSelf(parentUid));
        allow update: if false;
      }
    }

    // 클라이언트 오류 로그. 로그인한 사용자가 만들고 관리자만 읽는다.
    match /appErrors/{errorId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.stack is string
        && request.resource.data.stack.size() <= 8000
        && request.resource.data.context is string
        && request.resource.data.context.size() <= 100
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 300
        && request.resource.data.createdAt is number;
      allow read, delete: if isAdmin();
    }

    // 공개 순위표에는 이름/사진/포인트/레벨만 저장한다.
    // 학생과 연결된 부모는 계정 정리 시 자신(자녀)의 항목을 삭제할 수 있다.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if isAccountActive()
        && (isSelf(uid) || isParentOf(uid))
        && request.resource.data.uid == uid
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.level is number
        && request.resource.data.level >= 1;
      allow delete: if isAccountActive()
        && (isSelf(uid) || isParentOf(uid));
    }

    // 주간 리그. 주차별 하위 컬렉션으로 분리해 복합 인덱스 없이 조회한다.
    match /weeklyLeaderboards/{weekKey}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if isAccountActive()
        && (isSelf(uid) || isParentOf(uid))
        && request.resource.data.uid == uid
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.level is number
        && request.resource.data.level >= 1;
      allow delete: if isAccountActive()
        && (isSelf(uid) || isParentOf(uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
